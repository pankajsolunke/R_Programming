 20) Write a program to implement different loops and vectorization of missing values in R Programming.
vec <- c(10, NA, 15, NA, 20, 25, NA)
mean_value <- mean(vec, na.rm = TRUE)
# Vectorized approach to handle missing values
vec[is.na(vec)] <- mean_value
cat("Updated Vector with Vectorization:\n", vec, "\n")
# FOR loop to handle missing values
for (i in 1:length(vec)) if (is.na(vec[i])) vec[i] <- mean_value
cat("Updated Vector after FOR Loop:\n", vec, "\n")
# WHILE loop to handle missing values
i <- 1
while (i <= length(vec)) {
  if (is.na(vec[i])) 
    vec[i] <- mean_value;
  i <- i + 1 }
cat("Updated Vector after WHILE Loop:\n", vec, "\n")
# REPEAT loop to handle missing values
i <- 1
repeat { 
  if (i > length(vec)) 
    break; 
  if (is.na(vec[i])) 
    vec[i] <- mean_value; 
  i <- i + 1 }
cat("Updated Vector after REPEAT Loop:\n", vec, "\n")
vec <- c(10, NA, 15, NA, 20, 25, NA)
vec <- ifelse(is.na(vec), mean_value, vec)
cat("Updated Vector after Vectorization with ifelse:\n", vec, "\n")
 
